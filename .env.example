# Neon: cadena "pooled" (host con -pooler) para la app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Neon: cadena directa (sin -pooler) para migraciones
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
# Contraseña única de acceso a la app
APP_PASSWORD=""
# Secreto para firmar la cookie (openssl rand -hex 32)
AUTH_SECRET=""
# Vercel Blob (fotos de avisos). Déjalo vacío en local: se guardan en .uploads/
BLOB_READ_WRITE_TOKEN=""
# Importar el cuadrante desde imagen (Ajustes → Importar con IA). Pon la de la IA que uses.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Gemini (gratis con límites): clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional: cambiar de modelo (por defecto claude-opus-5-5 / gpt-5 / gemini-flash-latest)
# ANTHROPIC_MODEL=""
# OPENAI_MODEL=""
# GEMINI_MODEL=""
# Solo en local: respuesta de ejemplo sin llamar a la IA
# AI_IMPORT_FAKE="1"
