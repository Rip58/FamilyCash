generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {            // fila única id=1
  id              Int     @id @default(1)
  shiftStart      String  @default("21:30")
  shiftEnd        String  @default("06:30")
  breakStart      String  @default("02:00")
  breakEnd        String  @default("03:00")
  dayRolloverHour Int     @default(12)   // antes de esta hora "Hoy" = noche anterior
  daysOffPerWeek  Int     @default(2)
  passwordHash    String?                // si existe, sustituye a APP_PASSWORD
  aiProvider      String  @default("claude") // IA para importar el cuadrante desde imagen: claude | openai
}

model Department {          // Droguería, Botellería, ...
  id          String  @id @default(cuid())
  name        String
  color       String  @default("#64748b")
  sortOrder   Int     @default(0)
  targetStaff Int     @default(0)          // plazas previstas (Droguería 4, Botellería 1)
  active      Boolean @default(true)
  employees   Employee[]
  sections    Section[]
  nightNotes  NightNote[]
}

model Section {             // pasillos / tareas: Cerveza, Chocolate, ...
  id           String  @id @default(cuid())
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  segments     WorkSegment[]
  reports      Report[]
}

model StatusType {
  id          String  @id @default(cuid())
  code        String  @unique            // WORK, OFF, PAID_OFF, SICK, VACATION
  label       String
  color       String
  isWorking   Boolean @default(false)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  entries     DayEntry[]
}

model Employee {
  id                  String  @id @default(cuid())
  name                String
  alias               String?               // nombre corto para vistas compactas (Semana)
  defaultDepartmentId String?
  defaultDepartment   Department? @relation(fields: [defaultDepartmentId], references: [id])
  sortOrder           Int     @default(0)   // orden dentro del departamento
  rotaOrder           Int?                  // orden de las filas en el Excel del planning (se guarda al importar); null = al final
  fixedDaysOff        Int[]                 // 0=Lun … 6=Dom
  active              Boolean @default(true)
  notes               String?               // nota permanente
  days                DayEntry[]
  reports             Report[]
  fileNotes           EmployeeNote[]
  leaveRequests       LeaveRequest[]
  nightNotes          NightNote[]
}

model DayEntry {            // solo existe si el día difiere del patrón o tiene datos
  id            String   @id @default(cuid())
  date          DateTime @db.Date           // día de INICIO del turno
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  statusTypeId  String                      // PLANNING (solo lo cambia Semana / peticiones aprobadas)
  statusType    StatusType @relation(fields: [statusTypeId], references: [id])
  departmentId  String?                     // ubicación ese día (null = la habitual)
  reason        String?                     // motivo ausencia / cambio
  note          String?                     // nota del día sobre el empleado
  arrivedAt     String?                     // "22:15" si llega tarde
  leftAt        String?                     // "07:30" si se queda más / "04:00" si se va antes
  timeReason    String?
  extraMinutes  Int?                        // horas extra de esa noche, en minutos (p.ej. 60 = 1 h)
  extraNote     String?                     // motivo de las horas extra
  present       Boolean?                    // Hoy: true = validado (ha venido / ausencia confirmada); null = sin validar
  actualStatusTypeId String?                // Hoy: lo que pasó de verdad si NO cuadra con el planning; null = como el planning
  segments      WorkSegment[]
  updatedAt     DateTime @updatedAt
  @@unique([employeeId, date])
  @@index([date])
}

model WorkSegment {         // "Cerveza 21:30–05:00", "Chocolate 05:00–06:30"
  id          String   @id @default(cuid())
  dayEntryId  String
  dayEntry    DayEntry @relation(fields: [dayEntryId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
  label       String?                       // texto libre si no hay sección
  start       String                        // "HH:mm"
  end         String
  note        String?
  sortOrder   Int      @default(0)
}

model DayNote {             // nota general de la noche
  date  DateTime @id @db.Date
  text  String
}

model Protocol {            // hoja de protocolos
  id        String   @id @default(cuid())
  title     String
  category  String?                     // agrupador opcional: "Apertura", "Seguridad"...
  body      String                      // lista de viñetas en Markdown ("- " y "  - " anidadas)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  steps     ProtocolStep[]
}

model ProtocolStep {        // manual paso a paso: texto + foto opcional
  id            String   @id @default(cuid())
  protocolId    String
  protocol      Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  sortOrder     Int      @default(0)
  text          String
  photoUrl      String?
  photoPathname String?
  photoWidth    Int?
  photoHeight   Int?
  photoSize     Int      @default(0)
  @@index([protocolId, sortOrder])
}

model ShelfLocation {       // ubicaciones de los lineales: "Lineal PA", "Box"... (Ajustes)
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  planograms Planogram[]
}

model Planogram {           // lineal: cómo tiene que quedar (foto + nota), opcionalmente hasta una fecha
  id         String   @id @default(cuid())
  locationId String?
  location   ShelfLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  text       String
  until      DateTime? @db.Date
  photos     PlanogramPhoto[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PlanogramPhoto {      // mismos campos que ReportPhoto
  id          String    @id @default(cuid())
  planogramId String
  planogram   Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  url         String
  pathname    String
  width       Int
  height      Int
  size        Int       @default(0)
  sortOrder   Int       @default(0)
}

model Report {              // aviso con fotos + nota escrita
  id          String   @id @default(cuid())
  date        DateTime @db.Date           // día de turno al que pertenece
  employeeId  String?                     // empleado implicado (opcional)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sectionId   String?                     // dónde ocurrió (opcional)
  section     Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  text        String
  photos      ReportPhoto[]
  createdAt   DateTime @default(now())
  @@index([date])
}

model ReportPhoto {
  id        String @id @default(cuid())
  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String                        // Vercel Blob, o /api/files/... en local
  pathname  String                        // para poder borrarla del almacenamiento
  width     Int
  height    Int
  size      Int    @default(0)            // bytes, para el resumen de Almacenamiento
  sortOrder Int    @default(0)
}

model EmployeeNote {        // nota de ficha (privada, con fecha y hora)
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  occurredAt  DateTime                    // fecha y hora del evento
  category    String   @default("NOTE")   // NOTE | INCIDENT | PRAISE | TALK
  text        String
  photos      EmployeeNotePhoto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([employeeId, occurredAt])
}

model EmployeeNotePhoto {   // mismos campos que ReportPhoto
  id        String @id @default(cuid())
  noteId    String
  note      EmployeeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  width     Int
  height    Int
  size      Int    @default(0)
  sortOrder Int    @default(0)
}

model LeaveRequest {        // petición de cambio de fiesta / vacaciones / permiso
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String                     // SWAP_OFF | VACATION | PAID_OFF | OTHER
  dateFrom     DateTime @db.Date          // SWAP_OFF: día que deja de librar (A)
  dateTo       DateTime @db.Date          // SWAP_OFF: día que pasa a librar (B); rango: fin
  note         String?
  requestedAt  DateTime @db.Date
  status       String   @default("PENDING") // PENDING | APPROVED | DENIED
  decisionNote String?
  decidedAt    DateTime?
  appliedChanges Json?                    // estados previos de cada día, para poder revertir
  createdAt    DateTime @default(now())
  @@index([status])
  @@index([employeeId])
}

model PayrollSettings {     // fila única id=1: importes para la calculadora de nómina
  id                     Int     @id @default(1)
  employeeId             String?                 // "yo": empleado del que salen los datos del mes
  baseMonthlyCents       Int     @default(0)  // si no hay periodo de salario que cubra el mes
  respPlusCents          Int     @default(0)
  proratedExtraCents     Int     @default(0)
  nightPlusMode          String  @default("PERCENT") // PER_NIGHT | PERCENT
  nightPlusPerNightCents Int     @default(0)
  nightPlusPercent       Float   @default(25)
  overtimeMode           String  @default("LAW")   // LAW (fijo/h × recargo + nocturnidad/h) | FIXED
  overtimeSurchargePercent Float @default(40)      // art. 58.2 LRL: mínimo +40 %
  overtimeHourCents      Int     @default(0)       // si FIXED
  holidayWorkedCents     Int     @default(0)
  ssPercent              Float   @default(6.48)
  irpfPercent            Float   @default(12)
}

model Payslip {             // registro mensual; los campos null se calculan del cuadrante
  month          String   @id                  // "YYYY-MM"
  contractDays   Int?                          // alta/baja a mitad de mes (null = mes completo)
  daysOff        Int?
  vacationDays   Int?
  sickDays       Int?
  absentDays     Int?
  holidaysWorked Int?
  offDaysWorked  Int?                          // fiestas trabajadas (8 h extra cada una)
  extraMinutes   Int?
  grossCents     Int?                          // importes reales de la nómina
  netCents       Int?
  bankCents      Int?                          // lo cobrado realmente en el banco
  note           String?
  updatedAt      DateTime @updatedAt
}

model PayrollPeriod {       // salario por tramos de fechas (propuestas, subidas)
  id            String    @id @default(cuid())
  from          DateTime  @db.Date
  to            DateTime? @db.Date          // null = indefinido
  baseCents     Int                         // salario bruto mensual (jornada base)
  respPlusCents Int       @default(0)       // plus de responsabilidad
  @@index([from])
}

model NightNote {           // notas de la noche (Informe): varias por noche, generales o de un empleado
  id         String    @id @default(cuid())
  date       DateTime  @db.Date
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  kind       String    @default("INFO")   // INFO (informativa) | TASK (tarea pendiente de hacer)
  doneAt     DateTime?                    // tarea hecha
  text       String
  createdAt  DateTime  @default(now())
  @@index([date])
}
